{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "AuthConnection": ""
  },
  "FileStorage": {
    "UploadPath": "uploads/receipts",
    "MaxFileSizeBytes": 10485760,
    "AllowedFileTypes": "image/jpeg,image/jpg,image/png,image/gif"
  },
  "ImageCompression": {
    "MaxWidth": 800,
    "MaxHeight": 800,
    "JpegQuality": 75
  },
  "InvitationSettings": {
    "ExpirationDays": 7
  },
  "CookieSettings": {
    "Domain": "localhost",
    "ExpireTimeSpanHours": 24,
    "SlidingExpiration": true
  },
  "AuthenticationSettings": {
    "RevalidationIntervalMinutes": 30
  },
  "CorsSettings": {
    "AllowedOrigins": "https://localhost:5173,http://localhost:5173,https://localhost:5174,http://localhost:5174"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
