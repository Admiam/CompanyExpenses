# Development environment variables

# API Server (ASP.NET Core Web API)
VITE_API_BASE_URL=https://localhost:7200

# Auth Server (Blazor Identity)
VITE_AUTH_SERVER_URL=https://localhost:7169

# API timeout in milliseconds
VITE_API_TIMEOUT=30000

# Frontend dev server
VITE_APP_URL=http://localhost:5173

# File upload settings
VITE_MAX_FILE_SIZE_BYTES=10485760
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/jpg,image/png,image/gif

# UI/UX settings
VITE_REGISTRATION_REDIRECT_DELAY=2000
VITE_TOAST_DURATION=5000
