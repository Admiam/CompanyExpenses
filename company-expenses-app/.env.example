# Production environment variables - EXAMPLE
# Copy this file to .env.production and fill in your production values.
# NEVER commit production secrets to version control!

# API Server (ASP.NET Core Web API)
VITE_API_BASE_URL=https://api.your-domain.com

# Auth Server (Blazor Identity)
VITE_AUTH_SERVER_URL=https://auth.your-domain.com

# API timeout in milliseconds
VITE_API_TIMEOUT=30000

# Frontend URL
VITE_APP_URL=https://app.your-domain.com

# File upload settings
VITE_MAX_FILE_SIZE_BYTES=10485760
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/jpg,image/png,image/gif

# UI/UX settings
VITE_REGISTRATION_REDIRECT_DELAY=2000
VITE_TOAST_DURATION=5000
