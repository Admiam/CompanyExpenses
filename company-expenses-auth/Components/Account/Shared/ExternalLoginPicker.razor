@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using company_expenses_auth.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

@if (filteredLogins.Length == 0)
{
    @if (ShowDisabledButton)
    {
        <div class="w-full">
            <button type="button"
                class="w-full flex items-center justify-center gap-3 px-4 py-2.5 border border-gray-300 rounded-lg bg-white text-gray-700 font-medium hover:bg-gray-50 transition disabled:opacity-60 disabled:cursor-not-allowed"
                disabled>
                <svg class="w-5 h-5" viewBox="0 0 24 24">
                    <path fill="#4285F4"
                        d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                    <path fill="#34A853"
                        d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                    <path fill="#FBBC05"
                        d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
                    <path fill="#EA4335"
                        d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
                </svg>
                <span>Continue with Google</span>
            </button>
        </div>
    }
}
else
{
    <form class="w-full" action="Account/PerformExternalLogin" method="post">
        <AntiforgeryToken />
        <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
        @if (!string.IsNullOrEmpty(InvitationToken))
        {
            <input type="hidden" name="InvitationToken" value="@InvitationToken" />
        }
        @if (!string.IsNullOrEmpty(ExpectedEmail))
        {
            <input type="hidden" name="ExpectedEmail" value="@ExpectedEmail" />
        }
        <div class="space-y-3">
            @foreach (var provider in filteredLogins)
            {
                <button type="submit"
                    class="w-full flex items-center justify-center gap-3 px-4 py-2.5 border border-gray-300 rounded-lg bg-white text-gray-700 font-medium hover:bg-gray-50 hover:border-gray-400 transition shadow-sm"
                    name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                    @if (provider.Name == "Google")
                    {
                        <svg class="w-5 h-5" viewBox="0 0 24 24">
                            <path fill="#4285F4"
                                d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                            <path fill="#34A853"
                                d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                            <path fill="#FBBC05"
                                d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
                            <path fill="#EA4335"
                                d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
                        </svg>
                    }
                    <span>Continue with @provider.DisplayName</span>
                </button>
            }
        </div>
    </form>
}

@code {
    private AuthenticationScheme[] externalLogins = [];
    private AuthenticationScheme[] filteredLogins = [];

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    /// <summary>
    /// If set, only show Google login for Gmail addresses
    /// </summary>
    [Parameter]
    public string? FilterByEmail { get; set; }

    /// <summary>
    /// Expected email for OAuth validation (must match OAuth provider email)
    /// </summary>
    [Parameter]
    public string? ExpectedEmail { get; set; }

    /// <summary>
    /// Invitation token to pass through OAuth flow
    /// </summary>
    [Parameter]
    public string? InvitationToken { get; set; }

    /// <summary>
    /// Show disabled button when no providers available
    /// </summary>
    [Parameter]
    public bool ShowDisabledButton { get; set; } = true;

    protected override async Task OnInitializedAsync()
    {
        externalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToArray();
        FilterLogins();
    }

    private void FilterLogins()
    {
        if (string.IsNullOrEmpty(FilterByEmail))
        {
            // No filter - show all
            filteredLogins = externalLogins;
        }
        else
        {
            // Filter based on email domain
            var emailLower = FilterByEmail.ToLowerInvariant();
            var isGmail = emailLower.EndsWith("@gmail.com") || emailLower.EndsWith("@googlemail.com");

            filteredLogins = externalLogins.Where(p =>
            {
                if (p.Name == "Google")
                {
                    return isGmail; // Only show Google for Gmail addresses
                }
                return true; // Show other providers for all emails
            }).ToArray();
        }
    }
}